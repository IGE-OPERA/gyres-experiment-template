#!/usr/bin/env bash
# Auto-detect the current machine by matching `hostname -s` against the
# `hostnames` lists in machines/*.yaml. Port of lego-world's
# lego-detect-machine, minimal for gyres ledgers.
#
# Usage:
#   bin/detect-machine              # print detected machine name (or nothing)
#   bin/detect-machine --verbose    # print machine yaml path + nickname
#   bin/detect-machine --write      # write machines/<hostname>.yaml starter
#   bin/detect-machine --nickname N # nickname for --write (default: lowercased hostname)
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
MACHINES_DIR="${REPO_DIR}/machines"
GYRES_DIR="${GYRES_DIR:-${REPO_DIR}/../ocean-gyres}"

PYTHON="python3"
for candidate in "${GYRES_DIR}/.venv/bin/python" python3; do
    if "$candidate" -c "import yaml" 2>/dev/null; then
        PYTHON="$candidate"
        break
    fi
done

hostname=$(hostname -s)
write=false
verbose=false
nickname=""

while [ $# -gt 0 ]; do
    case "$1" in
        --write)    write=true ;;
        --verbose)  verbose=true ;;
        --nickname) nickname="$2"; shift ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

# Scan machines/*.yaml for a hostname match.
detected=""
detected_file=""
for yaml_file in "${MACHINES_DIR}"/*.yaml; do
    [ -f "$yaml_file" ] || continue
    base=$(basename "$yaml_file" .yaml)
    [ "$base" = "_template" ] && continue
    if "$PYTHON" - "$yaml_file" "$hostname" <<'PYEOF' 2>/dev/null
import sys, yaml

with open(sys.argv[1]) as f:
    d = yaml.safe_load(f) or {}
sys.exit(0 if sys.argv[2] in d.get("hostnames", []) else 1)
PYEOF
    then
        detected="$base"
        detected_file="$yaml_file"
        break
    fi
done

if [ "$write" = true ]; then
    out="${MACHINES_DIR}/${hostname}.yaml"
    if [ -f "$out" ]; then
        echo "ERROR: $out already exists" >&2
        exit 1
    fi
    [ -n "$nickname" ] || nickname=$(echo "$hostname" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]//g')
    {
        echo "# Generated by bin/detect-machine --write on $(hostname)."
        echo "nickname: \"${nickname}\""
        echo "hostnames:"
        echo "  - ${hostname}"
        echo "scheduler: null"
        echo "devices: \"auto\""
        echo "precision: \"fp64\""
        echo "gyres_dir: \"${GYRES_DIR}\""
        echo "gyres_python: \"\""
        echo "output_root: \"./output\""
        echo "env_setup: []"
    } > "$out"
    echo "Wrote $out"
    echo "Edit it to set scheduler/devices/paths, then commit."
    exit 0
fi

if [ -n "$detected" ]; then
    if [ "$verbose" = true ]; then
        echo "machine: $detected"
        echo "file:    $detected_file"
        echo "nickname: $($PYTHON - "$detected_file" <<'PYEOF'
import sys, yaml

with open(sys.argv[1]) as f:
    d = yaml.safe_load(f) or {}
print(d.get("nickname", ""))
PYEOF
)"
    else
        echo "$detected"
    fi
else
    echo "No machine config matches hostname '$hostname'." >&2
    echo "Create one with: bin/detect-machine --write" >&2
    exit 1
fi
